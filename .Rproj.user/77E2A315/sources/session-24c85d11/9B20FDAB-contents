project:
  type: website
  output-dir: docs

format:
  html:
    theme:
      light: 
        - cerulean
        - brand
      dark: 
        - darkly
        #- brand
    css: styles.css
    toc: true
    link-external-newwindow: true
    respect-user-color-scheme: true
    code-copy: true

bibliography: 
  - references.bib

execute: 
  freeze: auto

resource-path: ["styles", "."]
csl: styles/nature.csl
editor: visual

resources:
  - robots.txt

knitr:
  opts_knit:
    cache.path: .knitr_cache

metadata-files:
  - "materials/_sidebar.yml"
  - "help/_sidebar.yml"
  
website: 
  title: "Introduction to Bacterial Genomics"
  search: true
  page-navigation: true
  #reader-mode: true
  site-url: https://tahsinkhann.github.io/bacterial-genomics
